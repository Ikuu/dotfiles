[Unit]
Description=Set UMC202HD hardware output to 0 dB (it powers up at 104/127 = 41%%)
# Volume is done in software by WirePlumber (51-umc202hd-soft-mixer.conf),
# so the hardware mixer just needs to sit at full. alsactl restore doesn't do it.
After=wireplumber.service

[Service]
Type=oneshot
ExecStart=-/usr/bin/amixer -q -c U192k sset "UMC202HD 192k Output" 127

[Install]
WantedBy=default.target
